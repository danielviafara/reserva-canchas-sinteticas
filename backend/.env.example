# Conexion a PostgreSQL (ajusta usuario, contrasena y host segun tu equipo).
DATABASE_URL=postgresql+psycopg2://usuario@localhost:5432/goltime

JWT_SECRET=cambia-esta-clave-en-produccion
JWT_ALGORITHM=HS256

# Mostrar las sentencias SQL en consola (evidencia de transacciones): true | false
SQL_ECHO=false
